# Which provider the agent talks to: gemini, github or ollama
LLM_PROVIDER=gemini

# Optional, overrides the provider's default model
LLM_MODEL=

# Google AI Studio key, needed for LLM_PROVIDER=gemini
GEMINI_API_KEY=

# GitHub personal access token with the models:read permission, needed for LLM_PROVIDER=github
GITHUB_TOKEN=

# Ollama runs locally and needs no key
