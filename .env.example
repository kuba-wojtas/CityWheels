# Which provider the agent talks to: gemini, groq or ollama
LLM_PROVIDER=gemini

# Optional, overrides the provider's default model
LLM_MODEL=

# Google AI Studio key, needed for LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Groq key from console.groq.com, needed for LLM_PROVIDER=groq
GROQ_API_KEY=

# Ollama runs locally and needs no key
